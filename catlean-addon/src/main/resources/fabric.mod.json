{
  "schemaVersion": 1,
  "id": "catlean_race_addon",
  "version": "${version}",
  "name": "Race Addon",
  "description": "Race addon for CatLean — adds TargetTP, NoAimStrafe and TargetStrafe.",
  "authors": [
    "ItzSkater"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "catlean:addon": [
      {
        "adapter": "kotlin",
        "value": "gg.raceclient.catlean.RaceAddon"
      }
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-language-kotlin": "*",
    "fabric-api": "*",
    "minecraft": "26.2",
    "catlean": "*"
  }
}
